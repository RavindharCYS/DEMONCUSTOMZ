# ============================================================
# DemonCustomz — Environment Variables
# Copy this file to .env.local for local dev.
# In Vercel: Project Settings → Environment Variables.
# Vars prefixed VITE_ are exposed to the browser bundle — never
# put secrets (API keys) behind that prefix.
# ============================================================

## --- Public site content (safe for browser) ---
VITE_BRAND_NAME=DemonCustomz
VITE_TAGLINE=Crafting Dreams on Two Wheels
VITE_LOGO_URL=/public/logos/logo.webp

VITE_PHONE=+91 98765 43210
VITE_WHATSAPP_NUMBER=+91 98765 43210
VITE_WHATSAPP_MESSAGE=Hi DemonCustomz, I'd like to know more!
VITE_CONTACT_EMAIL=contact@demoncustomz.in
VITE_ADDRESS=Chennai, Tamil Nadu, India

VITE_INSTAGRAM_URL=https://instagram.com/demoncustomz
VITE_FACEBOOK_URL=https://facebook.com/demoncustomz
VITE_YOUTUBE_URL=https://youtube.com/@demoncustomz
VITE_TWITTER_URL=https://twitter.com/demoncustomz

## --- Instagram Graph API (for live reel feed) ---
## https://developers.facebook.com/docs/instagram-platform/instagram-graph-api
VITE_INSTAGRAM_ACCESS_TOKEN=
VITE_INSTAGRAM_USER_ID=

## --- Google Reviews ---
VITE_GOOGLE_PLACE_ID=
VITE_GOOGLE_REVIEWS_URL=https://g.page/r/your-place-id/review

## --- Server-side only (NO VITE_ prefix — never sent to the browser) ---
## Resend: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=DemonCustomz <notify@demoncustomz.in>
NOTIFY_TO_EMAIL=contact@demoncustomz.in
BRAND_NAME=DemonCustomz

## Google Places API key (Places API enabled, restrict by IP/referrer in console)
GOOGLE_PLACES_API_KEY=
